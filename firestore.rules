rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEditorialAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'zaina2408@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'authorId', 'publishedAt', 'category']) &&
        data.keys().hasOnly(['id', 'title', 'subtitle', 'summary', 'content', 'authorId', 'publishedAt', 'category', 'imageUrl', 'readTime', 'isCurrent', 'isFeatured', 'likes', 'views', 'comments']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
        (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 1000)) &&
        (!('summary' in data) || (data.summary is string && data.summary.size() <= 5000)) &&
        data.content is list && data.content.size() > 0 && data.content.size() <= 500 && data.content[0] is string &&
        data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
        data.publishedAt is string && data.publishedAt.size() <= 64 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
        (!('readTime' in data) || (data.readTime is string && data.readTime.size() <= 64)) &&
        (!('isCurrent' in data) || data.isCurrent is bool) &&
        (!('isFeatured' in data) || data.isFeatured is bool) &&
        (!('likes' in data) || data.likes is number) &&
        (!('views' in data) || data.views is number) &&
        (!('comments' in data) || (data.comments is list && data.comments.size() <= 500));
    }

    function isValidWriter(data) {
      return data.keys().hasAll(['id', 'name', 'role']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'bio', 'avatarUrl', 'email', 'twitter', 'location', 'joinedDate']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.role is string && data.role.size() > 0 && data.role.size() <= 200 &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 5000)) &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500000)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('twitter' in data) || (data.twitter is string && data.twitter.size() <= 100)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
        (!('joinedDate' in data) || (data.joinedDate is string && data.joinedDate.size() <= 64));
    }

    // Articles Collection (Public investigative reporting)
    match /articles/{articleId} {
      allow get: if isValidId(articleId);
      allow list: if true;
      allow create: if isValidId(articleId) && isValidArticle(incoming()) && incoming().id == articleId && isEditorialAdmin();
      allow update: if isValidId(articleId) && isValidArticle(incoming()) && incoming().id == existing().id && (
        (isEditorialAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'summary', 'content', 'authorId', 'publishedAt', 'category', 'imageUrl', 'readTime', 'isCurrent', 'isFeatured', 'likes', 'views', 'comments'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'views', 'comments'])
      );
      allow delete: if isValidId(articleId) && isEditorialAdmin();
    }

    // Writers Collection (Public correspondent dossiers)
    match /writers/{writerId} {
      allow get: if isValidId(writerId);
      allow list: if true;
      allow create: if isValidId(writerId) && isValidWriter(incoming()) && incoming().id == writerId && isEditorialAdmin();
      allow update: if isValidId(writerId) && isValidWriter(incoming()) && incoming().id == existing().id && isEditorialAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'bio', 'avatarUrl', 'email', 'twitter', 'location', 'joinedDate']);
      allow delete: if isValidId(writerId) && isEditorialAdmin();
    }

    // Admin authorization metadata
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isSignedIn() && (request.auth.uid == adminId || isEditorialAdmin());
      allow list: if isEditorialAdmin();
      allow create, update, delete: if isValidId(adminId) && isEditorialAdmin();
    }

    // Event gallery (public photos, editor-only changes)
    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'imageUrl', 'date', 'location', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'imageUrl', 'date', 'location', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 700000 &&
        data.date is string && data.date.size() > 0 && data.date.size() <= 100 &&
        data.location is string && data.location.size() > 0 && data.location.size() <= 300 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create, update: if isValidId(eventId) && isValidEvent(incoming()) && incoming().id == eventId && isEditorialAdmin();
      allow delete: if isValidId(eventId) && isEditorialAdmin();
    }

    // Shared video dispatches (public, editor-only changes)
    function isValidVideo(data) {
      return data.keys().hasAll(['id', 'title', 'videoUrl', 'platform', 'publishedAt', 'likes', 'createdAt']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'videoUrl', 'platform', 'publishedAt', 'likes', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 5000)) &&
        data.videoUrl is string && data.videoUrl.size() > 0 && data.videoUrl.size() <= 2000 &&
        data.platform in ['YouTube', 'Vimeo', 'Other'] &&
        data.publishedAt is string && data.publishedAt.size() <= 100 &&
        data.likes is number && data.likes >= 0 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    match /videos/{videoId} {
      allow get, list: if true;
      allow create, update: if isValidId(videoId) && isValidVideo(incoming()) && incoming().id == videoId && isEditorialAdmin();
      allow delete: if isValidId(videoId) && isEditorialAdmin();
    }
  }
}
